lang: en
langs:
  - en
  - ru
allowHtml: false
strict: true
staticContent: true
allowCustomResources: true
resources:
  script:
    - _assets/script/quite-admin-theme.js
codeHighlight:
  light: github
  dark: github-dark
template:
  features:
    substitutions: false
docs-viewer:
  project-name: quite-admin
  logo-options:
    title: quite-admin
    url: ../{lang}/
